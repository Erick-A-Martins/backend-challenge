{
  "name": "backend-challenge",
  "module": "src/main.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "bun check",
    "start": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "test": "bun test",
    "migration:create": "bunx --bun mikro-orm migration:create",
    "migration:up": "bunx --bun mikro-orm migration:up",
    "migration:down": "bunx --bun mikro-orm migration:down"
  },
  "mikro-orm": {
    "configPaths": ["./src/shared/infrastructure/database/mikro-orm.config.ts"]
  },
  "devDependencies": {
    "@mikro-orm/cli": "^7.2.7",
    "@types/bun": "^1.4.4",
    "typescript": "5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@mikro-orm/core": "^7.2.7",
    "@mikro-orm/decorators": "^7.2.7",
    "@mikro-orm/migrations": "^7.2.7",
    "@mikro-orm/nestjs": "^7.1.0",
    "@mikro-orm/postgresql": "^7.2.7",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}
